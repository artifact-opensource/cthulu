# Cthulu Trading Bot - Environment Variables
# Copy this file to .env and fill in your actual values

# MetaTrader 5 Credentials
MT5_LOGIN=your_account_number
MT5_PASSWORD=your_password
MT5_SERVER=your_broker_server
# Optional shared MT5 terminal executable path
# MT5_PATH="C:\\Program Files\\MetaTrader 5\\terminal64.exe"

# Trading Configuration
ACCOUNT_CURRENCY=USD
RISK_PER_TRADE=0.02
MAX_DAILY_LOSS=0.05

# Database
DATABASE_PATH=Cthulu.db

# Logging
LOG_LEVEL=INFO
LOG_TO_FILE=true

# API Keys (if using external data sources)
# ALPHA_VANTAGE_KEY=your_key_here
# FINANCIAL_MODELING_PREP_KEY=your_key_here

# Monitoring (optional)
# TELEGRAM_BOT_TOKEN=your_token
# TELEGRAM_CHAT_ID=your_chat_id

# Development
DEBUG=false
DRY_RUN=false

# Execution owner: legacy (default) or agentic. Only one system may manage orders.
CTHULU_EXECUTION_MODE=agentic

# Dashboard access: loopback (default), lan, or tailscale. Remote modes require a token.
DASHBOARD_ACCESS_MODE=loopback
# DASHBOARD_TOKEN is generated when remote access is first enabled; keep it private.
# DASHBOARD_PORT=8765


