# ---- Cthulu agent (copy what you need into your .env; the dashboard writes these for you) ----
# Default provider is Cloudflare AI Gateway. Configure the key and account ID in Settings or here.
LLM_PROVIDER=cloudflare
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_GATEWAY_ID=default
# Optional custom OpenAI-compatible endpoint; normally derived from the account ID.
# CLOUDFLARE_BASE_URL=
CLOUDFLARE_MODEL=@cf/qwen/qwen3-30b-a3b-fp8
# Other providers (all optional, hot-swappable from Settings):
# OPENROUTER_API_KEY=        OPENROUTER_BASE_URL=https://openrouter.ai/api/v1      OPENROUTER_MODEL=openrouter/free
# OPENAI_API_KEY=            OPENAI_BASE_URL=https://api.openai.com/v1              OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=         ANTHROPIC_BASE_URL=https://api.anthropic.com           ANTHROPIC_MODEL=claude-sonnet-5-5
# GEMINI_API_KEY=            GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# XAI_API_KEY=               XAI_BASE_URL=https://api.x.ai/v1                       XAI_MODEL=grok-4

# Broker: paper (simulated, default) or mt5
BROKER=paper
# MT5_LOGIN=  MT5_PASSWORD=  MT5_SERVER=  MT5_PATH=
# Fully autonomous trading on a REAL-money MT5 account is blocked unless you set this to 1:
# LIVE_RUN_CONFIRM=1

# Agent behaviour (all editable in the dashboard)
AGENT_AUTONOMY=autonomous        # observe | approval | autonomous
AGENT_SYMBOLS=XAUUSD,EURUSD,BTCUSD
AGENT_MANAGE_FOREIGN=true        # also manage positions/orders opened by other bots or by hand
AGENT_MAX_THINKS_PER_HOUR=20     # protects free-tier rate limits

# World-intel API (your 95+ source aggregator). Pull with URL, or push to POST /api/world/ingest
# WORLD_API_URL=  WORLD_API_KEY=  WORLD_API_PATHS=/a,/b  WORLD_REFRESH_MIN=30

# Dashboard
# DASHBOARD_HOST=127.0.0.1  DASHBOARD_PORT=8765
# DASHBOARD_TOKEN=            # REQUIRED if you bind anything other than localhost
